"ACTION_RUN_ON_VALIDATED_ENEMIES": {
"action_data": [{
"ACTION_DIRECT_DAMAGE": {
"damage": 10
}
}],
"exclude_parent": true,
"max_target_amount": 1,
"random_selection": true,
"validator_data": [{
"VALIDATOR_ENEMY_NAME_CONTAINS": {
"search_text": "Goblin"
}
}]
}
}, {
"ACTION_RESTORE_ENEMY_POISE": {
"fill_to_max": true,
"target_override": 1
}
}])
intent = SubResource("Resource_pva1x")

