"VALIDATOR_SOURCE_HAS_STATUS_EFFECT": {
"comparison_value": 0,
"operator": ">",
"status_effect_object_id": "status_effect_dungeon_slime_splash_ready"
}
}])
intents = Array[ExtResource("3_variant")]([SubResource("Resource_xq7d2")])
