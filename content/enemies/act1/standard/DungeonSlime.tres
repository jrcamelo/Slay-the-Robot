"target_override": 1
}
}, {
"ACTION_ADD_ENEMY_HEALTH": {
"health_amount": 5,
"multiply_health_amount_by_player_current_energy": true,
"target_override": 1
}
}])
intent = SubResource("Resource_rnu2m")

[sub_resource type="Resource" id="Resource_m56qg"]
