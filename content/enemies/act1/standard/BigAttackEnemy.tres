[ext_resource type="Script" path="res://data/prototype/EnemyDifficultyOverrideData.gd" id="5_diff"]

[sub_resource type="Resource" id="Resource_048h2"]
script = ExtResource("5_diff")
difficulty_level = 1
top_level_overrides = Dictionary[String, Variant]({
"enemy_health": 50,
"enemy_health_max": 50,
"enemy_poise": 25,
"enemy_poise_max": 25
})

[sub_resource type="Resource" id="Resource_6yeht"]
