[ext_resource type="Script" path="res://data/prototype/EnemyIntentData.gd" id="4_intent"]
[ext_resource type="Script" path="res://data/prototype/EnemyReactiveStageData.gd" id="4_j3rd4"]
[ext_resource type="Script" path="res://data/prototype/EnemyDifficultyOverrideData.gd" id="5_diff"]

[sub_resource type="Resource" id="Resource_qejop"]
script = ExtResource("5_diff")
difficulty_level = 1
top_level_overrides = Dictionary[String, Variant]({
"enemy_health": 8,
"enemy_health_max": 8,
"enemy_poise": 4,
"enemy_poise_max": 4
})

[sub_resource type="Resource" id="Resource_hlybu"]
script = ExtResource("4_intent")
damage = 5
block = 5
number_of_attacks = 1

[sub_resource type="Resource" id="Resource_j3rd4"]
script = ExtResource("3_variant")
intent = SubResource("Resource_hlybu")

[sub_resource type="Resource" id="Resource_sg6b4"]
script = ExtResource("2_stage")
label = "Attack"
intents = Array[ExtResource("3_variant")]([SubResource("Resource_j3rd4")])
next_stage_id = "stage_2"
object_id = "stage_1"

[sub_resource type="Resource" id="Resource_d1byx"]
script = ExtResource("4_intent")
damage = 3
block = 7
number_of_attacks = 2

[sub_resource type="Resource" id="Resource_3b1bu"]
script = ExtResource("3_variant")
intent = SubResource("Resource_d1byx")

[sub_resource type="Resource" id="Resource_jepss"]
script = ExtResource("2_stage")
label = "Multi Attack"
intents = Array[ExtResource("3_variant")]([SubResource("Resource_3b1bu")])
