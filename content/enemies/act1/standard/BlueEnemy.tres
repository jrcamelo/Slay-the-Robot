object_id = "stage_2"

[resource]
script = ExtResource("1_enemy")
enemy_name = "Blue Enemy"
enemy_health = 5
enemy_health_max = 5
enemy_poise = 2
enemy_poise_max = 2
opening_stage_id = "stage_1"
